# ============================================
# AI Provider API Keys
# ============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# ============================================
# Default Model Configuration
# ============================================
DEFAULT_MODEL_PROVIDER=anthropic
DEFAULT_CLAUDE_MODEL=claude-sonnet-4-5-20250929
DEFAULT_GPT_MODEL=gpt-4-turbo
DEFAULT_GEMINI_MODEL=gemini-2.0-flash-exp
DEFAULT_DEEPSEEK_MODEL=deepseek-chat
DEFAULT_QWEN_MODEL=qwen-turbo

# ============================================
# Three-Agent System Configuration
# ============================================
ENABLE_THREE_AGENT_MODE=true
DEBATE_ROUNDS=3
ROTATION_STRATEGY=sequential  # Options: sequential, random, performance-based

# Agent Provider Assignment (optional - defaults to auto-select)
PROPOSER_PROVIDER=anthropic
CHALLENGER_PROVIDER=openai
JUDGE_PROVIDER=google

# ============================================
# Coding Session Configuration
# ============================================
MAX_CODING_ITERATIONS=3
AUTO_APPROVE_CODE=false
CODING_TIMEOUT=300000  # 5 minutes in milliseconds

# ============================================
# Session Management
# ============================================
AUTO_SAVE_SESSION=true
MAX_SESSIONS=100
# SESSION_DIR=/custom/path/to/sessions  # Optional: override default session directory

# ============================================
# Performance & Caching
# ============================================
ENABLE_CACHING=true
CACHE_SIZE=100  # Number of cached items
CACHE_TTL=300000  # Cache time-to-live in milliseconds (5 minutes)

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info  # Options: debug, info, warn, error, none
ENABLE_FILE_LOGGING=false  # Set to true to save logs to file

# ============================================
# Sandbox Configuration
# ============================================
SANDBOX_IMAGE=ubuntu:latest
SANDBOX_TIMEOUT=300000  # 5 minutes in milliseconds
SANDBOX_AUTO_CLEANUP=true

# Custom Provider Configuration
# You can add multiple custom OpenAI-compatible providers
# Format: CUSTOM_PROVIDER_N_* where N is 1, 2, 3, etc.

# Example 1: Custom Local LLM
# CUSTOM_PROVIDER_1_NAME=local-llm
# CUSTOM_PROVIDER_1_API_KEY=sk-xxx
# CUSTOM_PROVIDER_1_BASE_URL=http://localhost:8000/v1
# CUSTOM_PROVIDER_1_MODEL=llama-3-70b
# CUSTOM_PROVIDER_1_TYPE=openai-compatible

# Example 2: Another Custom Provider
# CUSTOM_PROVIDER_2_NAME=custom-ai
# CUSTOM_PROVIDER_2_API_KEY=your_api_key
# CUSTOM_PROVIDER_2_BASE_URL=https://api.custom-ai.com/v1
# CUSTOM_PROVIDER_2_MODEL=custom-model-name
# CUSTOM_PROVIDER_2_TYPE=openai-compatible

# Supported Provider Types:
# - openai-compatible: Any provider with OpenAI-compatible API (default)
# Built-in providers: anthropic, openai, google, deepseek, qwen

# Visual Testing Configuration
# Set to 'Yes' to enable visual Chrome browser tests in sandbox
# Tests will run step-by-step with delays to demonstrate the process
VISUAL_TEST=No
